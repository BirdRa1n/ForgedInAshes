<configs>
	<!-- F1-T02: machines M01, M02, M03 (phase 1: no power).
	     How the game binds a workstation (read from Assembly-CSharp.dll, 3.4.0 b10):
	       - <property class="Workstation"> CraftingAreaRecipes = which recipe craft_area values it shows.
	       - Block property WorkstationWindow = XUi window group to open; if empty the game uses
	         "workstation_<blockName>" (TileEntityWorkstation.OnLockResponseLocal / WorkstationData ctor).
	       - Vanilla tableSaw uses the same pattern (own craft area + WorkstationWindow="workstation_workbench").
	     So the machines reuse vanilla windows and need no XUi of their own (yet).
	     Salvage drops and RepairItems avoid Mechanical Parts / Spring on purpose (see PLANO_MOD.md 12.1). -->
	<append xpath="/blocks">

		<!-- M01 Foundry: copy of vanilla forge with its own craft area, WITHOUT the smelter input.
		     XUiM_Recipes.FilterRecipesByWorkstation only hides use_smelter/replace_smelter variants when
		     craftingArea == "forge" (hard-coded), so a smelting copy showed every recipe twice.
		     Phase 1: direct-scrap recipes only (works in both SmeltingType modes); vanilla
		     "workstation_forge_nosmelting" window = tools + fuel + output, no input grid. -->
		<block name="feFoundry">
			<property name="Class" value="Forge"/>
			<property class="Workstation">
				<property name="CraftingAreaRecipes" value="feFoundry"/>
				<property name="Modules" value="tools,output,fuel"/>
				<property name="ToolNames" value="1,2,3"/>
			</property>
			<property name="WorkstationWindow" value="workstation_forge_nosmelting"/>
			<property name="CreativeMode" value="Player"/>
			<property name="DescriptionKey" value="feFoundryDesc"/>
			<property name="CustomIcon" value="forge"/>
			<property name="CustomIconTint" value="ffb080"/>
			<property name="WorkstationIcon" value="ui_game_symbol_forge"/>
			<property name="Stacknumber" value="1"/>
			<property name="Material" value="Mstone_scrap"/>
			<property name="Shape" value="ModelEntity"/>
			<property name="Model" value="@:Entities/Crafting/forgeWorkstationPrefab.prefab"/>
			<property name="MultiBlockDim" value="2,2,1"/>
			<property name="ImposterDontBlock" value="true"/>
			<property name="WaterFlow" value="permitted"/>
			<property name="ParticleName" value="forgeWorkstation"/>
			<property name="ParticleOffset" value="0,0.4,0.5"/>
			<property name="Place" value="TowardsPlacerInverted"/>
			<property name="OnlySimpleRotations" value="true"/>
			<property name="Path" value="solid"/>
			<property name="IsTerrainDecoration" value="true"/>
			<property name="StabilitySupport" value="true"/>
			<property name="Weight" value="0"/>
			<property name="EconomicValue" value="1000"/>
			<property name="MaxDamage" value="800"/>
			<property name="HeatMapStrength" value="6"/>
			<property name="HeatMapTime" value="5000"/>
			<property name="HeatMapFrequency" value="1000"/>
			<property name="BuffsWhenWalkedOn" value="buffBurningEnvironment"/>
			<property name="ActiveRadiusEffects" value="buffCampfireAOE,5"/>
			<property name="OpenSound" value="forge_open"/>
			<property name="CloseSound" value="forge_close"/>
			<property name="CraftSound" value="forge_smelt_click"/>
			<property name="CraftCompleteSound" value="forge_item_complete"/>
			<property name="TakeDelay" value="15"/>
			<property class="RepairItems">
				<property name="resourceCobblestones" value="50"/>
			</property>
			<drop event="Harvest" name="resourceRockSmall" count="40" tag="allHarvest,perkJunkMiner"/>
			<drop event="Harvest" name="resourceClayLump" count="20" tag="allHarvest,perkJunkMiner"/>
			<drop event="Harvest" name="resourceLeather" count="5" tag="allHarvest,perkJunkMiner"/>
			<drop event="Destroy" count="0"/>
			<drop event="Fall" name="terrDestroyedStone" count="1" prob="0.75" stick_chance="1"/>
			<property name="SortOrder1" value="B281"/>
			<property name="SortOrder2" value="0210"/>
			<property name="Group" value="Building,TCScience,advBuilding"/>
			<property name="Tags" value="workstationSkill"/>
			<property name="FilterTags" value="MC_playerBlocks,SC_decor"/>
			<property name="SoundPickup" value="forge_grab"/>
			<property name="SoundPlace" value="forge_place"/>
		</block>

		<!-- M02 Parts Press: workbench-style station (model of vanilla combineStation). -->
		<block name="fePress">
			<property name="Class" value="Workstation"/>
			<property class="Workstation">
				<property name="Modules" value="output"/>
				<property name="CraftingAreaRecipes" value="fePress"/>
			</property>
			<property name="WorkstationWindow" value="workstation_workbench"/>
			<property name="CreativeMode" value="Player"/>
			<property name="DescriptionKey" value="fePressDesc"/>
			<property name="DisplayType" value="blockMulti"/>
			<property name="CustomIcon" value="combineStation"/>
			<property name="CustomIconTint" value="a8bccc"/>
			<property name="WorkstationIcon" value="ui_game_symbol_workbench"/>
			<property name="Stacknumber" value="1"/>
			<property name="Material" value="Mmetal"/>
			<property name="Shape" value="ModelEntity"/>
			<property name="Model" value="@:Entities/Crafting/combineWorkbenchPrefab.prefab"/>
			<property name="ModelOffset" value="0,0,0"/>
			<property name="MultiBlockDim" value="2,2,1"/>
			<property name="ImposterDontBlock" value="true"/>
			<property name="WaterFlow" value="permitted"/>
			<property name="Place" value="TowardsPlacerInverted"/>
			<property name="OnlySimpleRotations" value="true"/>
			<property name="IsTerrainDecoration" value="true"/>
			<property name="StabilitySupport" value="false"/>
			<property name="Weight" value="0"/>
			<property name="EconomicValue" value="2000"/>
			<property name="MaxDamage" value="800"/>
			<property name="HeatMapStrength" value="5"/>
			<property name="HeatMapTime" value="5000"/>
			<property name="HeatMapFrequency" value="1000"/>
			<property name="OpenSound" value="open_workbench"/>
			<property name="CloseSound" value="close_workbench"/>
			<property name="TakeDelay" value="15"/>
			<property class="RepairItems">
				<property name="resourceForgedIron" value="15"/>
				<property name="resourceNail" value="30"/>
			</property>
			<drop event="Harvest" name="resourceScrapIron" count="150" tag="allHarvest,perkJunkMiner"/>
			<drop event="Harvest" name="terrStone" count="0" tool_category="Disassemble"/>
			<drop event="Harvest" name="resourceForgedIron" count="15" tag="salvageHarvest"/>
			<drop event="Harvest" name="resourceMetalPipe" count="2" tag="salvageHarvest"/>
			<drop event="Destroy" count="0"/>
			<drop event="Fall" name="scrapMetalPile" count="1" prob="0.75" stick_chance="1"/>
			<property name="SortOrder1" value="B281"/>
			<property name="SortOrder2" value="0310"/>
			<property name="Group" value="Building,TCScience,advBuilding"/>
			<property name="Tags" value="workstationSkill"/>
			<property name="FilterTags" value="MC_playerBlocks,SC_decor"/>
			<property name="SoundPickup" value="workbench_grab"/>
			<property name="SoundPlace" value="workbench_place"/>
		</block>

		<!-- M03 Lathe: workbench-style station (model of vanilla dev-only tableSaw, 1x1). -->
		<block name="feLathe">
			<property name="Class" value="Workstation"/>
			<property class="Workstation">
				<property name="Modules" value="output"/>
				<property name="CraftingAreaRecipes" value="feLathe"/>
			</property>
			<property name="WorkstationWindow" value="workstation_workbench"/>
			<property name="CreativeMode" value="Player"/>
			<property name="DescriptionKey" value="feLatheDesc"/>
			<property name="CustomIcon" value="tableSaw"/>
			<property name="CustomIconTint" value="d8b070"/>
			<property name="WorkstationIcon" value="ui_game_symbol_table_saw"/>
			<property name="CraftIcon" value="ui_game_symbol_table_saw"/>
			<property name="Stacknumber" value="1"/>
			<property name="Material" value="Miron_scrap"/>
			<property name="Shape" value="ModelEntity"/>
			<property name="Model" value="@:Entities/Crafting/table_sawPrefab.prefab"/>
			<property name="ImposterDontBlock" value="true"/>
			<property name="WaterFlow" value="permitted"/>
			<property name="Place" value="TowardsPlacerInverted"/>
			<property name="OnlySimpleRotations" value="true"/>
			<property name="Path" value="solid"/>
			<property name="IsTerrainDecoration" value="true"/>
			<property name="StabilitySupport" value="true"/>
			<property name="Weight" value="0"/>
			<property name="EconomicValue" value="2000"/>
			<property name="MaxDamage" value="800"/>
			<property name="HeatMapStrength" value="5"/>
			<property name="HeatMapTime" value="5000"/>
			<property name="HeatMapFrequency" value="1000"/>
			<property name="OpenSound" value="open_workbench"/>
			<property name="CloseSound" value="close_workbench"/>
			<property name="TakeDelay" value="15"/>
			<property class="RepairItems">
				<property name="resourceForgedIron" value="20"/>
				<property name="resourceNail" value="40"/>
			</property>
			<drop event="Harvest" name="resourceScrapIron" count="200" tag="allHarvest,perkJunkMiner"/>
			<drop event="Harvest" name="terrStone" count="0" tool_category="Disassemble"/>
			<drop event="Harvest" name="resourceForgedIron" count="20" tag="salvageHarvest"/>
			<drop event="Harvest" name="resourceMetalPipe" count="3" tag="salvageHarvest"/>
			<drop event="Destroy" count="0"/>
			<drop event="Fall" name="scrapMetalPile" count="1" prob="0.75" stick_chance="1"/>
			<property name="SortOrder1" value="B281"/>
			<property name="SortOrder2" value="0320"/>
			<property name="Group" value="Building,TCScience,advBuilding"/>
			<property name="Tags" value="workstationSkill"/>
			<property name="FilterTags" value="MC_playerBlocks,SC_decor"/>
			<property name="SoundPickup" value="workbench_grab"/>
			<property name="SoundPlace" value="workbench_place"/>
		</block>

	</append>

	<!-- F1-T05: no Mechanical Parts / Spring from salvaging blocks (PLANO_MOD.md 12.1, D5: some scrap iron, 0 ready parts).
	     Order matters: rename the Destroy drops first, then remove the Harvest drops.
	     Destroy drops are RENAMED to scrap iron instead of removed: XML.txt says a block without any Destroy drop
	     "will always drop self", and 12 blocks (safes, ATM, pipe valve) have MP/Spring as their only Destroy drop.
	     Children using Extends inherit the parent's drops, so patching the parents covers them. -->
	<set xpath="/blocks/block/drop[@event='Destroy'][@name='resourceMechanicalParts' or @name='resourceSpring']/@name">resourceScrapIron</set>
	<remove xpath="/blocks/block/drop[@event='Harvest'][@name='resourceMechanicalParts' or @name='resourceSpring']"/>
</configs>
