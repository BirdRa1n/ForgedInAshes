<configs>
	<!-- F1-T02: build recipes for the phase-1 machines.
	     Crafted in the player's inventory (no craft_area): the vanilla workbench costs 20 Mechanical Parts,
	     so requiring it would break "from zero, without loot" (PLANO_MOD.md P1).
	     always_unlocked: D3 says M01-M03 are not behind perks/books.
	     Costs = PLANO_MOD.md section 5.1 (balance values, adjust there first). -->
	<append xpath="/recipes">
		<!-- M01 Foundry: same ingredients as the vanilla forge recipe -->
		<recipe name="feFoundry" count="1" always_unlocked="true">
			<ingredient name="resourceCobblestones" count="50"/>
			<ingredient name="woodLogPillar100" count="1"/>
			<ingredient name="resourceLeather" count="10"/>
			<ingredient name="resourceDuctTape" count="3"/>
			<ingredient name="resourceMetalPipe" count="3"/>
		</recipe>
		<!-- M02 Parts Press: 30 Forged Iron, 60 Nails, 40 Wood, 4 Short Iron Pipe -->
		<recipe name="fePress" count="1" always_unlocked="true">
			<ingredient name="resourceForgedIron" count="30"/>
			<ingredient name="resourceNail" count="60"/>
			<ingredient name="resourceWood" count="40"/>
			<ingredient name="resourceMetalPipe" count="4"/>
		</recipe>
		<!-- M03 Lathe: 40 Forged Iron, 80 Nails, 30 Wood, 6 Short Iron Pipe -->
		<recipe name="feLathe" count="1" always_unlocked="true">
			<ingredient name="resourceForgedIron" count="40"/>
			<ingredient name="resourceNail" count="80"/>
			<ingredient name="resourceWood" count="30"/>
			<ingredient name="resourceMetalPipe" count="6"/>
		</recipe>
	</append>

	<!-- F2-T02: E02 Charcoal Kiln, crafted in the inventory (no lock, like M01-M03).
	     Cost = PLANO_MOD.md 5.2: 30 Cobblestone Rocks, 10 Clay Soil, 20 Wood. -->
	<append xpath="/recipes">
		<recipe name="feCharcoalKiln" count="1" always_unlocked="true">
			<ingredient name="resourceCobblestones" count="30"/>
			<ingredient name="resourceClayLump" count="10"/>
			<ingredient name="resourceWood" count="20"/>
		</recipe>
	</append>

	<!-- F2-T03: E03 Coal Generator (inventory; PLANO_MOD.md 5.2: 15 MP, 10 Plate, 8 Gear, 5 Short Iron Pipe)
	     and I02 Flywheel (Lathe; PLANO_MOD.md 6: 4 Gear + 2 Plate + 1 Shaft). -->
	<append xpath="/recipes">
		<recipe name="feCoalGenerator" count="1" always_unlocked="true">
			<ingredient name="resourceMechanicalParts" count="15"/>
			<ingredient name="feResourceIronPlate" count="10"/>
			<ingredient name="feResourceGear" count="8"/>
			<ingredient name="resourceMetalPipe" count="5"/>
		</recipe>
		<recipe name="feFlywheel" count="1" craft_area="feLathe" craft_time="6" always_unlocked="true">
			<ingredient name="feResourceGear" count="4"/>
			<ingredient name="feResourceIronPlate" count="2"/>
			<ingredient name="feResourceIronShaft" count="1"/>
		</recipe>
	</append>

	<!-- F2-T04: E01 Crank, crafted in the inventory (PLANO_MOD.md 5.2: 20 Forged Iron, 20 Wood, 10 Nails).
	     It must stay buildable without the Lathe/Press: it is the first source of Charge. -->
	<append xpath="/recipes">
		<recipe name="feCrank" count="1" always_unlocked="true">
			<ingredient name="resourceForgedIron" count="20"/>
			<ingredient name="resourceWood" count="20"/>
			<ingredient name="resourceNail" count="10"/>
		</recipe>
	</append>

	<!-- F1-T04 (fixed): M01 Foundry = the vanilla forge "replace_smelter" recipes (direct scrap: Scrap Iron + Clay)
	     for Forged Iron, Nails and Short Iron Pipe. No use_smelter/unit_* recipes: the game filters those variants
	     only for craft_area "forge", so both showed up (see blocks.xml). Generated with:
	     python tools/copy_recipes.py forge feFoundry resourceForgedIron resourceNail resourceMetalPipe  (keep replace_smelter) -->
	<append xpath="/recipes">
		<recipe name="resourceForgedIron" count="1" craft_area="feFoundry" is_trackable="false" tags="replace_smelter,perkAdvancedEngineering">
			<ingredient name="resourceScrapIron" count="10"/>
			<ingredient name="resourceClayLump" count="1"/>
			<effect_group>
				<passive_effect name="CraftingIngredientCount" operation="perc_add" level="0,1,2,3,4" value=".25,.25,.25,.12,.06" tags="resourceScrapIron"/>
			</effect_group>
		</recipe>
		<recipe name="resourceMetalPipe" count="1" craft_area="feFoundry" is_trackable="false" tags="replace_smelter,perkAdvancedEngineering">
			<ingredient name="resourceScrapIron" count="10"/>
			<ingredient name="resourceClayLump" count="1"/>
			<effect_group>
				<passive_effect name="CraftingIngredientCount" operation="perc_add" level="0,1,2,3,4" value=".25,.25,.25,.12,.06" tags="resourceScrapIron"/>
			</effect_group>
		</recipe>
		<recipe name="resourceNail" count="1" craft_area="feFoundry" is_trackable="false" tags="replace_smelter,perkAdvancedEngineering">
			<ingredient name="resourceScrapIron" count="1"/>
			<ingredient name="resourceClayLump" count="1"/>
		</recipe>
	</append>

	<!-- F1-T04: M02 Parts Press and M03 Lathe. Values = PLANO_MOD.md section 6 / section 9 (craft time 2-4 s).
	     craft_time is explicit because Forged Iron has CraftingIngredientTime=10 (default time would be ~20 s+). -->
	<append xpath="/recipes">
		<!-- I03 Iron Plate: 2 Forged Iron -> 1 (M02) -->
		<recipe name="feResourceIronPlate" count="1" craft_area="fePress" craft_time="3" always_unlocked="true">
			<ingredient name="resourceForgedIron" count="2"/>
		</recipe>
		<!-- I04 Iron Shaft: 2 Forged Iron -> 1 (M03) -->
		<recipe name="feResourceIronShaft" count="1" craft_area="feLathe" craft_time="3" always_unlocked="true">
			<ingredient name="resourceForgedIron" count="2"/>
		</recipe>
		<!-- I05 Gear: 1 Iron Plate -> 2 (M03) -->
		<recipe name="feResourceGear" count="2" craft_area="feLathe" craft_time="2" always_unlocked="true">
			<ingredient name="feResourceIronPlate" count="1"/>
		</recipe>
		<!-- I06 Mechanical Parts: 2 Gear + 1 Iron Shaft -> 1 (M03). ~3 Forged Iron per part. -->
		<recipe name="resourceMechanicalParts" count="1" craft_area="feLathe" craft_time="4" always_unlocked="true">
			<ingredient name="feResourceGear" count="2"/>
			<ingredient name="feResourceIronShaft" count="1"/>
		</recipe>
		<!-- I07 Spring: 1 Iron Shaft + 1 Forged Iron -> 2 (M03). ~1.5 Forged Iron per spring. -->
		<recipe name="resourceSpring" count="2" craft_area="feLathe" craft_time="3" always_unlocked="true">
			<ingredient name="feResourceIronShaft" count="1"/>
			<ingredient name="resourceForgedIron" count="1"/>
		</recipe>
	</append>
