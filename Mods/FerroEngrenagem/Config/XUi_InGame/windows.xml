<configs>
	<!-- The look text of the machines was shrunk to fit the 70 px prompt (ShrinkContent): let it grow in height instead,
	     at the normal font size (user report 2026-11-24, "o texto esta minusculo"). -->
	<setattribute xpath="/windows/window[@name='interactionPrompt']/label[@name='lblText']" name="overflow">resizeheight</setattribute>

	<!-- Recipe book window (RecipeBook.cs, controller XUiC_FeRecipes): title, one page of lines, previous / next / close -->
	<append xpath="/windows">
		<window name="feRecipes" width="1200" height="700" pos="-600,350" anchor="Center" depth="15" cursor_area="true"
		        controller="FerroEngrenagem.FeRecipes, FerroEngrenagem">
			<rect name="header" height="43" depth="1">
				<headerbg />
				<sprite depth="2" name="windowIcon" style="icon32px" pos="4,-5" sprite="ui_game_symbol_book"/>
				<label style="header.name" text="{fetitle}" width="1100" />
			</rect>
			<rect name="content" pos="0,-46" height="654" depth="1">
				<sprite depth="8" name="backgroundMain" sprite="menu_empty3px" pos="0,0" width="1200" color="[black]" type="sliced" fillcenter="false" />
				<sprite color="[darkGrey]" type="sliced" />
				<label depth="3" name="feRecipesBody" pos="12,-10" text="{febody}" width="1176" height="580" font_size="22" />

				<rect depth="3" pos="0,-602" height="48">
					<button depth="3" name="feRecipesPrev" pos="8,-4" width="180" height="40" sprite="menu_empty" defaultcolor="[mediumGrey]" hoversprite="ui_game_select_row" hovercolor="[white]" type="sliced" hoverscale="1.0"/>
					<label depth="4" pos="8,-8" width="180" height="32" justify="center" text="&lt;&lt;" font_size="28" />
					<label depth="4" pos="400,-8" width="400" height="32" justify="center" text="{fepage}" font_size="26" />
					<button depth="3" name="feRecipesNext" pos="1012,-4" width="180" height="40" sprite="menu_empty" defaultcolor="[mediumGrey]" hoversprite="ui_game_select_row" hovercolor="[white]" type="sliced" hoverscale="1.0"/>
					<label depth="4" pos="1012,-8" width="180" height="32" justify="center" text="&gt;&gt;" font_size="28" />
					<button depth="3" name="feRecipesClose" pos="820,-4" width="180" height="40" sprite="menu_empty" defaultcolor="[mediumGrey]" hoversprite="ui_game_select_row" hovercolor="[white]" type="sliced" hoverscale="1.0"/>
					<label depth="4" pos="820,-8" width="180" height="32" justify="center" text="OK" font_size="28" />
				</rect>
			</rect>
		</window>
	</append>
</configs>
