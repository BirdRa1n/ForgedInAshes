<?xml version="1.0" encoding="UTF-8"?>
<!-- Chain craft ("modo Create", PLANO_CRAFT.md, D11). Read by the DLL (Processes.cs) and by tools/check_processes.py
     and tools/gen_site.py (the tutorial site). NOT a vanilla config file: it lives in Data/, not Config/.

     <fluid>   a fluid of the pipe network (the ones in FluidNetwork.cs are known; new ones are declared here)
     <machine> a block that runs processes (new ones: planned="true" until they exist in blocks.xml)
     <item>    a new intermediate item (planned="true" until it exists in items.xml)
     <process> one step. kind: melt | cast | press | turn | crush | wash | mix | dry | distill | spin | assemble
               | sequence. Inputs: input/count (item), fluid_in/liters. Outputs: output/out_count (item),
               fluid_out/out_liters. mold = the mold item a cast needs. time in seconds, torque in UT.
               planned="true": designed, not in the game yet (the DLL skips it, the validator only checks names).
     <chain>   a tutorial: the product and its steps in order (process ids), for the site.

     Names in text="" are Portuguese (the site is in pt-BR). Numbers are proposals until the balancing talk. -->
<processes>
	<!-- fluids (D11, section 6.1) -->
	<fluid name="molten_brass" text="Latão Fundido"/>
	<fluid name="molten_lead" text="Chumbo Fundido"/>
	<fluid name="molten_iron" text="Ferro Fundido"/>
	<fluid name="molten_steel" text="Aço Fundido"/>

	<!-- machines: existing ones and the new blocks of PLANO_CRAFT.md section 3 -->
	<machine name="feFoundry" text="Fundição"/>
	<machine name="fePress" text="Prensa de Peças"/>
	<machine name="feAmmoPress" text="Prensa de Munição"/>
	<machine name="feLathe" text="Torno"/>
	<machine name="feMixer" text="Misturadora"/>
	<machine name="feAssembler" text="Montadora"/>
	<machine name="feCaster" text="Mesa de Moldagem"/>
	<machine name="feMetalChute" text="Calha de Metal"/>
	<machine name="feCrusher" text="Triturador"/>
	<machine name="feWasher" text="Lavadora"/>
	<machine name="feSteamDryer" text="Secador a Vapor"/>
	<machine name="feChemMixer" text="Misturador Químico"/>
	<machine name="feInductionFurnace" text="Forno de Indução"/>
	<machine name="feCasterElectric" text="Moldadora Industrial"/>
	<machine name="feRetortKiln" text="Forno de Retorta"/>
	<machine name="feBiodigester" text="Biodigestor"/>
	<machine name="feRefinery" text="Refinaria"/>
	<machine name="feInlinePress" text="Prensa em Linha" planned="true"/>

	<!-- new items -->
	<item name="feMoldCasing" text="Molde de Cápsula" metals="molten_brass"/>
	<item name="feMoldBulletTip" text="Molde de Ponta" metals="molten_lead"/>
	<item name="feMoldIngot" text="Molde de Lingote" metals="molten_iron,molten_steel"/>
	<item name="feMoldPlate" text="Molde de Chapa" metals="molten_iron"/>
	<item name="feMoldPipe" text="Molde de Tubo" metals="molten_iron"/>
	<item name="feMoldGear" text="Molde de Engrenagem" metals="molten_iron"/>
	<item name="feCasingRaw" text="Cápsula Bruta"/>
	<item name="feNitreEarth" text="Terra Nitrosa"/>
	<item name="feBioMash" text="Mosto Orgânico"/>
	<item name="feBiofuel" text="Biocombustível"/>
	<item name="feCoalDust" text="Pó de Carvão"/>
	<item name="feNitratePure" text="Salitre Purificado"/>
	<item name="feGunPowderWet" text="Pólvora Úmida"/>

	<!-- ammo 9mm (PLANO_CRAFT.md 4.1) -->
	<process id="melt_brass" kind="melt" machine="feFoundry" input="resourceScrapBrass" count="1"
	         fluid_out="molten_brass" out_liters="10" time="2"
	         text="A Fundição derrete a sucata de latão que chega pela esteira."/>
	<process id="cast_casing" kind="cast" machine="feCaster" mold="feMoldCasing" fluid_in="molten_brass" liters="25"
	         output="feCasingRaw" out_count="5" time="6"
	         text="O latão desce pela Calha até a Mesa de Moldagem com o Molde de Cápsula. Esfria em 6 s (3 s com água ao lado)."/>
	<process id="press_casing" kind="press" machine="feInlinePress" input="feCasingRaw" count="1"
	         output="resourceBulletCasing" out_count="1" time="1" torque="64" planned="true"
	         text="A Prensa em Linha, em cima da esteira, repuxa a cápsula bruta."/>
	<process id="melt_lead" kind="melt" machine="feFoundry" input="resourceScrapLead" count="1"
	         fluid_out="molten_lead" out_liters="10" time="2"
	         text="A Fundição derrete a sucata de chumbo."/>
	<process id="cast_tip" kind="cast" machine="feCaster" mold="feMoldBulletTip" fluid_in="molten_lead" liters="20"
	         output="resourceBulletTip" out_count="10" time="5"
	         text="O chumbo vai para uma Mesa de Moldagem com o Molde de Ponta."/>
	<!-- F8.1: until the in-line press (F8.3) the Ammo Press makes the casing from its recipe list (recipes.xml) -->
	<process id="press_casing_bench" kind="press" machine="feAmmoPress" input="feCasingRaw" count="1"
	         output="resourceBulletCasing" out_count="1" time="1"
	         text="Na Prensa de Munição (receita fixa ou à mão), a cápsula bruta vira o revestimento de bala."/>
	<process id="crush_coal" kind="crush" machine="feCrusher" input="resourceCoal" count="1"
	         output="feCoalDust" out_count="2" time="2" torque="128"
	         text="O Triturador mói o carvão."/>
	<process id="wash_nitrate" kind="wash" machine="feWasher" input="resourcePotassiumNitratePowder" count="2"
	         fluid_in="water" liters="5" output="feNitratePure" out_count="2" time="3"
	         text="A Lavadora limpa o salitre com água."/>
	<process id="mix_powder" kind="mix" machine="feChemMixer" input="feCoalDust,feNitratePure" count="1,2"
	         fluid_in="water" liters="1" output="feGunPowderWet" out_count="3" time="4" torque="64"
	         text="O Misturador Químico junta o pó de carvão, o salitre e um pouco de água."/>
	<process id="dry_powder" kind="dry" machine="feSteamDryer" input="feGunPowderWet" count="1"
	         fluid_in="steam" liters="2" output="resourceGunPowder" out_count="1" time="3"
	         text="O Secador a Vapor seca a pólvora."/>
	<process id="assemble_9mm" kind="assemble" machine="feAssembler"
	         input="resourceBulletCasing,resourceBulletTip,resourceGunPowder" count="1,1,1"
	         output="ammo9mmBulletBall" out_count="1" time="2.4" planned="true"
	         text="A Montadora, ligada aos baús de cápsulas, pontas e pólvora, monta a bala com a receita escolhida."/>

	<!-- F8.1 metallurgy: iron and steel -->
	<process id="melt_scrap_iron" kind="melt" machine="feFoundry" input="resourceScrapIron" count="1"
	         fluid_out="molten_iron" out_liters="2" time="1"
	         text="A Fundição derrete a sucata de ferro (rende pouco)."/>
	<process id="melt_iron" kind="melt" machine="feFoundry" input="resourceForgedIron" count="1"
	         fluid_out="molten_iron" out_liters="10" time="2"
	         text="A Fundição derrete o ferro forjado."/>
	<process id="melt_steel" kind="melt" machine="feFoundry" input="resourceForgedSteel" count="1"
	         fluid_out="molten_steel" out_liters="10" time="3"
	         text="A Fundição derrete o aço forjado."/>
	<process id="cast_ingot_iron" kind="cast" machine="feCaster" mold="feMoldIngot" fluid_in="molten_iron" liters="10"
	         output="resourceForgedIron" out_count="1" time="3"
	         text="O Molde de Lingote transforma o ferro fundido em ferro forjado."/>
	<process id="cast_ingot_steel" kind="cast" machine="feCaster" mold="feMoldIngot" fluid_in="molten_steel" liters="10"
	         output="resourceForgedSteel" out_count="1" time="4"
	         text="O Molde de Lingote também aceita aço fundido."/>
	<process id="cast_plate" kind="cast" machine="feCaster" mold="feMoldPlate" fluid_in="molten_iron" liters="20"
	         output="feResourceIronPlate" out_count="1" time="4"
	         text="O Molde de Chapa faz a chapa de ferro."/>
	<process id="cast_pipe" kind="cast" machine="feCaster" mold="feMoldPipe" fluid_in="molten_iron" liters="30"
	         output="resourceMetalPipe" out_count="1" time="5"
	         text="O Molde de Tubo faz o cano de metal."/>
	<process id="cast_gear" kind="cast" machine="feCaster" mold="feMoldGear" fluid_in="molten_iron" liters="15"
	         output="feResourceGear" out_count="1" time="4"
	         text="O Molde de Engrenagem faz a engrenagem bruta."/>

	<!-- F8.2 chemistry -->
	<process id="crush_stone" kind="crush" machine="feCrusher" input="resourceRockSmall" count="2"
	         output="resourceCrushedSand" out_count="1" time="2" torque="128"
	         text="O Triturador também mói pedra em areia."/>

	<!-- Industrial versions: the Induction Furnace melts like the Foundry (electric); the Industrial Casting Table
	     uses the same molds (MetalWorks looks the casts up on feCaster) -->
	<process id="ind_melt_brass" kind="melt" machine="feInductionFurnace" input="resourceScrapBrass" count="1"
	         fluid_out="molten_brass" out_liters="10" time="1" text="O Forno de Indução derrete com eletricidade."/>
	<process id="ind_melt_lead" kind="melt" machine="feInductionFurnace" input="resourceScrapLead" count="1"
	         fluid_out="molten_lead" out_liters="10" time="1" text="O Forno de Indução derrete o chumbo."/>
	<process id="ind_melt_scrap_iron" kind="melt" machine="feInductionFurnace" input="resourceScrapIron" count="1"
	         fluid_out="molten_iron" out_liters="2" time="0.5" text="O Forno de Indução derrete a sucata de ferro."/>
	<process id="ind_melt_iron" kind="melt" machine="feInductionFurnace" input="resourceForgedIron" count="1"
	         fluid_out="molten_iron" out_liters="10" time="1" text="O Forno de Indução derrete o ferro forjado."/>
	<process id="ind_melt_steel" kind="melt" machine="feInductionFurnace" input="resourceForgedSteel" count="1"
	         fluid_out="molten_steel" out_liters="10" time="1.5" text="O Forno de Indução derrete o aço forjado."/>
	<process id="retort_wood" kind="distill" machine="feRetortKiln" input="resourceWood" count="5"
	         output="feResourceCharcoal" out_count="1" time="20"
	         text="O Forno de Retorta (elétrico) transforma madeira em carvão vegetal, com esteira na entrada e na saída."/>

	<!-- Biodigester (slow and expensive on purpose) -->
	<process id="nitre_flesh" kind="mix" machine="feBiodigester" input="foodRottingFlesh,resourceBone" count="10,4"
	         fluid_in="water" liters="20" output="feNitreEarth" out_count="1" time="360"
	         text="Com ossos, a carne podre vira Terra Nitrosa (a antiga nitreira)."/>
	<process id="nitre_crops" kind="mix" machine="feBiodigester" input="foodCropCorn,resourceBone" count="15,4"
	         fluid_in="water" liters="20" output="feNitreEarth" out_count="1" time="480"
	         text="Milho com ossos também vira Terra Nitrosa, mais devagar."/>
	<process id="rot_meat" kind="mix" machine="feBiodigester" input="foodRawMeat" count="5"
	         fluid_in="water" liters="5" output="foodRottingFlesh" out_count="5" time="180"
	         text="O Biodigestor apodrece a carne crua."/>
	<process id="mash_flesh" kind="mix" machine="feBiodigester" input="foodRottingFlesh" count="10"
	         fluid_in="water" liters="20" output="feBioMash" out_count="1" time="360"
	         text="Sem ossos, a carne podre fermenta em Mosto Orgânico."/>
	<process id="mash_corn" kind="mix" machine="feBiodigester" input="foodCropCorn" count="12"
	         fluid_in="water" liters="20" output="feBioMash" out_count="1" time="300"
	         text="Milho fermenta em Mosto Orgânico."/>
	<process id="mash_potato" kind="mix" machine="feBiodigester" input="foodCropPotato" count="12"
	         fluid_in="water" liters="20" output="feBioMash" out_count="1" time="300"
	         text="Batata fermenta em Mosto Orgânico."/>
	<process id="wash_nitre_earth" kind="wash" machine="feWasher" input="feNitreEarth" count="1"
	         fluid_in="water" liters="10" output="resourcePotassiumNitratePowder" out_count="4" time="6"
	         text="A Lavadora tira o salitre da Terra Nitrosa (lixiviação)."/>
	<process id="distill_biofuel" kind="distill" machine="feRefinery" input="feBioMash,resourceAnimalFat" count="2,1"
	         output="feBiofuel" out_count="1" time="60"
	         text="Na Refinaria (receita fixa ou à mão), 2 Mostos + 1 Gordura viram 1 Biocombustível. No Motor a Gasolina, 3 latas valem 1 de gasolina."/>

	<chain product="feResourceCharcoal" text="Carvão Vegetal industrial" phase="Industrial" steps="retort_wood"/>
	<chain product="resourcePotassiumNitratePowder" text="Salitre de carne podre" phase="Industrial"
	       steps="rot_meat,nitre_flesh,wash_nitre_earth"/>
	<chain product="feBiofuel" text="Biocombustível" phase="Industrial" steps="rot_meat,mash_flesh,distill_biofuel"/>
	<chain product="resourceGunPowder" text="Pólvora" phase="F8.2" steps="crush_coal,wash_nitrate,mix_powder,dry_powder"/>
	<chain product="resourceBulletCasing" text="Revestimento de Bala (cápsula)" phase="F8.1"
	       steps="melt_brass,cast_casing,press_casing_bench"/>
	<chain product="resourceBulletTip" text="Ponta de Bala" phase="F8.1" steps="melt_lead,cast_tip"/>
	<chain product="feResourceIronPlate" text="Chapa de Ferro fundida" phase="F8.1" steps="melt_scrap_iron,cast_plate"/>
	<chain product="ammo9mmBulletBall" text="Bala 9mm" phase="F8.3"
	       steps="melt_brass,cast_casing,press_casing,melt_lead,cast_tip,crush_coal,wash_nitrate,mix_powder,dry_powder,assemble_9mm"/>
</processes>
