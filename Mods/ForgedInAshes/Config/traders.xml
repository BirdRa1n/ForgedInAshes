<configs>
	<!-- F3-T05: traders no longer sell Mechanical Parts or Springs (only vanilla entries: generalResources). -->
	<remove xpath="/traders/trader_item_groups/trader_item_group[@name='generalResources']/item[@name='resourceMechanicalParts']"/>
	<remove xpath="/traders/trader_item_groups/trader_item_group[@name='generalResources']/item[@name='resourceSpring']"/>
	<!-- F3-T07: the traders' "workstations" group sells the mod equivalents instead of the vanilla stations. -->
	<set xpath="/traders/trader_item_groups/trader_item_group/item[@name='forge']/@name">feFoundry</set>
	<set xpath="/traders/trader_item_groups/trader_item_group/item[@name='workbench']/@name">feAssembler</set>
	<set xpath="/traders/trader_item_groups/trader_item_group/item[@name='chemistryStation']/@name">feRefinery</set>
	<set xpath="/traders/trader_item_groups/trader_item_group/item[@name='cementMixer']/@name">feMixer</set>
</configs>
