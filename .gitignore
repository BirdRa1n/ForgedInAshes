# Caminho pessoal da instalação do jogo
tools/game_path.txt

# Saídas das ferramentas
tools/out/
*.csv.tmp

# Python
__pycache__/
*.pyc
.venv/

# C# / Visual Studio (fase 2+)
src/**/bin/
src/**/obj/
.vs/
*.user
*.suo

# DLL do mod: gerada por tools/build.ps1 (vai no pacote de release, não no git)
Mods/ForgedInAshes/*.dll

# DLLs do jogo nunca vão para o repositório (não redistribuir)
src/**/GameRefs/

# Unity / assets (fase 6)
Library/
Temp/
*.blend1

# SO
Thumbs.db
desktop.ini
.DS_Store

# Unity project in Art/UnityProject (only Assets/Editor, Packages and ProjectSettings are versioned)
Art/UnityProject/Library/
Art/UnityProject/Logs/
Art/UnityProject/UserSettings/
Art/UnityProject/Temp/
Art/UnityProject/Build/
Art/UnityProject/obj/
Art/UnityProject/*.csproj
Art/UnityProject/*.sln
Art/UnityProject/Assets/Models/
Art/UnityProject/Assets/Models.meta
Art/UnityProject/Assets/Prefabs/
Art/UnityProject/Assets/Prefabs.meta

# local switch for the verbose mod log (ForgedInAshesMod.Verbose)
Mods/ForgedInAshes/debug.txt

# Site de tutoriais (site/): dependências e build local (a Vercel compila no deploy)
site/node_modules/
site/dist/

# Compiled asset bundle (models + textures, built by Unity FeBuild): not versioned any more (2026-11-27) so the
# textures can be as large / high quality as we want. Players download it separately (GitHub Releases); see
# Mods/ForgedInAshes/Resources/README.md.
Mods/ForgedInAshes/Resources/*.unity3d
Mods/ForgedInAshes/Resources/*.manifest
